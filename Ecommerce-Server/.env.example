# ==============================================
# Server Environment Configuration
# ==============================================

# Port the Express server will listen on
PORT=5000

# Environment mode: 'development' | 'production'
NODE_ENV=development

# ==============================================
# Database Configuration
# ==============================================

# MongoDB connection string
# Local MongoDB example: mongodb://127.0.0.1:27017/ecommerce_db
# MongoDB Atlas example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/ecommerce_db?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce_db

# ==============================================
# Authentication & Security
# ==============================================

# Secret key used for signing and verifying JWT tokens (use a strong random string)
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# JWT expiration time (e.g., 1d, 7d, 30d)
JWT_EXPIRES_IN=7d

# ==============================================
# Media Storage: Cloudinary
# (Obtain from https://console.cloudinary.com/)
# ==============================================

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==============================================
# AI Integration: Google Gemini API
# (Obtain from https://aistudio.google.com/)
# ==============================================

GEMINI_API_KEY=your_gemini_api_key
# Model identifier (Gemini 3.1 Flash Lite)
GEMINI_MODEL=gemini-3.1-flash-lite
